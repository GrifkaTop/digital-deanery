# Generate local secrets with: node scripts/init-env.mjs
SITE_ADDRESS=localhost
APP_ORIGIN=https://localhost
POSTGRES_DB=deanery
POSTGRES_USER=deanery_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
# node scripts/init-auth-env.mjs
AUTH_SECRET=
DEMO_A_LOGIN=
DEMO_A_PASSWORD=
DEMO_B_LOGIN=
DEMO_B_PASSWORD=
DEMO_MOBILE_PASSWORD=
ENABLE_DEMO_LOGIN=false
# Optional on the demo stand after renaming synthetic profile 3 (seed default: test3).
DEMO_MOBILE_LOGIN=

# Optional clock for academic data on the localhost stand. Leave empty for real Moscow time.
DEMO_ACADEMIC_NOW=

# Optional Qwen gateway for a restricted test stand with synthetic questions.
ASSISTANT_QWEN_BASE_URL=
ASSISTANT_QWEN_MODEL=
ASSISTANT_QWEN_API_KEY=

# Persistent Qwen bridge on a restricted test stand. See docs/local-development.md.
# COMPOSE_FILE=compose.yaml:compose.qwen.yaml
# TESLA_QWEN_SSH_KEY=/absolute/path/to/private-key
# TESLA_QWEN_KNOWN_HOSTS=/absolute/path/to/verified-known-hosts
# Optional SSH target overrides (same-host deployment: host.docker.internal).
# TESLA_QWEN_SSH_HOST=host.docker.internal
# TESLA_QWEN_SSH_PORT=8022
# TESLA_QWEN_SSH_USER=modelonly
# Future server setup: node scripts/init-server-env.mjs cabinet.example.org
# See docs/server-migration.md; this creates .env.server, not .env.
